# Your Base wallet address — where USDC payments land. REQUIRED.
PAY_TO_ADDRESS=0xYourBaseWalletAddressHere

# Network: "base-sepolia" (testnet, free public facilitator) or "base" (mainnet, real USDC).
X402_NETWORK=base-sepolia

# Price per /bounties call.
X402_PRICE=$0.01

# Facilitator. Testnet default works keyless.
# Mainnet ("base") -> use Coinbase facilitator: https://x402.org/facilitator with CDP, or your own.
X402_FACILITATOR_URL=https://x402.org/facilitator

# GitHub token -> raises rate limits (60/hr -> 5000/hr). Strongly recommended in prod.
GITHUB_TOKEN=

PORT=3000
