{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "x402-bounty-radar",
  "main": "src/worker.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "PAY_TO_ADDRESS": "0x07c9c5D37D28693CfD9DDB8858b2046853E1fA95",
    "X402_NETWORK": "base",
    "X402_PRICE": "$0.01",
    "X402_FACILITATOR_URL": "https://facilitator.xpay.sh"
  }
  // GITHUB_TOKEN -> set as a secret in prod:  npx wrangler secret put GITHUB_TOKEN
}
